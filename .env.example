# Configuracion de la herramienta. Copia este archivo como .env y editalo.
# El .env NO se sube al repositorio: contiene datos tuyos.
#
# La aplicacion lo lee siempre, la lances como la lances (interfaz, diagnostico,
# briefing diario o cron). Una variable de entorno real tiene prioridad sobre
# lo que pongas aqui.

# Tu email. La SEC lo exige para identificar quien consulta sus datos.
INVEST_CONTACT=tu-email@ejemplo.com

# Orden de los proveedores de precios. Util si uno no es accesible desde tu red.
# Valores posibles: stooq, yahoo (separados por comas). Por defecto: stooq,yahoo
# PRICE_PROVIDERS=yahoo,stooq

# Clave gratuita de Finnhub (opcional). Anade PER, beta y cotizacion mas fresca.
# Se saca en https://finnhub.io/
# FINNHUB_API_KEY=

# Rutas (opcionales; los valores por defecto suelen estar bien)
# INVEST_DB=personal_invest.db
# INVEST_CACHE=.data_cache
