# Configuracion de la herramienta. Copia este archivo como .env y editalo.
# El .env NO se sube al repositorio: contiene datos tuyos.
#
# La aplicacion lo lee siempre, la lances como la lances (interfaz, diagnostico,
# briefing diario o cron). Una variable de entorno real tiene prioridad sobre
# lo que pongas aqui.

# Tu email. La SEC lo exige para identificar quien consulta sus datos.
INVEST_CONTACT=tu-email@ejemplo.com

# Orden de los proveedores de precios. Util si uno no es accesible desde tu red.
# Valores posibles: stooq, yahoo, twelvedata (separados por comas).
# PRICE_PROVIDERS=yahoo,stooq

# Clave gratuita de Twelve Data (opcional). Tercer respaldo de precios, solo se
# usa si Stooq y Yahoo fallan. Se saca en https://twelvedata.com/
# TWELVEDATA_API_KEY=

# Clave gratuita de Finnhub (opcional). Anade PER, beta y cotizacion mas fresca.
# Se saca en https://finnhub.io/
# FINNHUB_API_KEY=

# Rutas (opcionales; los valores por defecto suelen estar bien)
# INVEST_DB=personal_invest.db
# INVEST_CACHE=.data_cache

# --- Contrasena (solo si publicas la herramienta en internet) ---------------
#
# En tu propio ordenador dejalo VACIO: la aplicacion arranca abierta y es lo
# correcto ahi. En cuanto la publiques, sin esto cualquiera con la direccion
# veria tu cartera y podria borrarla.
#
# NO escribas tu contrasena aqui. Generala con:
#     .venv/bin/python backend/set_password.py
# que calcula el hash y lo deja escrito debajo. Guardado asi, quien lea el
# archivo no puede deducir la contrasena.
# APP_PASSWORD_HASH=

# La sesion dura 12 horas y luego vuelve a pedir la contrasena. No es
# configurable a proposito: una sesion eterna en un movil perdido es tu cartera
# entera a la vista de quien lo encuentre.

# SOLO para probar en local sin HTTPS. En internet NO lo pongas: quita la
# marca Secure de la cookie y la sesion podria viajar en claro.
# APP_INSECURE_COOKIE=1
