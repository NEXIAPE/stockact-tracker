# --- Base de datos (local-first) ---
DATABASE_URL="file:./dev.db"

# --- Motor de IA (arquitectura agnóstica vía puerto/adaptador) ---
# Proveedor. Valores: claude | groq | gemini | ollama | mock
# Si la clave del proveedor elegido falta, cae a "mock" (gratis) sin romper.
LLM_PROVIDER="mock"

# --- GRATIS: Groq (recomendado) — Llama 3.3 70B, sin tarjeta ---
# Crea tu clave en https://console.groq.com/keys  y pon:
#   LLM_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- GRATIS: Google Gemini — capa gratuita ---
# Crea tu clave en https://aistudio.google.com/apikey  y pon:
#   LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- PAGO: Claude (Anthropic) — mejor calidad, no entrena con tus datos ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- GRATIS y PRIVADO: Ollama (modelo local) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
