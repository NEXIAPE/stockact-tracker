# --- Base de datos (local-first) ---
DATABASE_URL="file:./dev.db"

# --- Motor de IA (arquitectura agnóstica vía puerto/adaptador) ---
# Proveedor por defecto. Valores: claude | mock | ollama
LLM_PROVIDER="claude"

# Claude (Anthropic) — usado cuando LLM_PROVIDER=claude
# Si no hay clave, el sistema cae automáticamente al adaptador "mock"
# para que la app sea ejecutable sin coste.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Ollama (local, gratis) — usado cuando LLM_PROVIDER=ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
